{
  "name": "sleekdo",
  "version": "1.0.0",
  "description": "Agent orchestration and verification system",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "sleekdo": "bin/sleekdo.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/unit/*.test.ts test/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test test/e2e/pi-e2e.test.ts",
    "test:all": "node --experimental-strip-types --test test/unit/*.test.ts test/integration/*.test.ts test/e2e/pi-e2e.test.ts",
    "start": "node --experimental-strip-types bin/sleekdo.ts"
  },
  "keywords": [
    "orchestrator",
    "agent",
    "verification",
    "sleekdo"
  ],
  "author": "Sleekdo Contributors",
  "license": "MIT",
  "homepage": "https://github.com/Deexv/sleekdo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deexv/sleekdo.git"
  },
  "bugs": {
    "url": "https://github.com/Deexv/sleekdo/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
